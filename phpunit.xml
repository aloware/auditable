<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
>
    <testsuites>
        <testsuite name="Auditable Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!--
        ignoreIndirectDeprecations keeps failOnDeprecation meaningful: only
        deprecations triggered by this package fail the run, not those raised
        inside dependencies on newer PHP versions.
    -->
    <source ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="DB_CONNECTION" value="testing"/>
    </php>
</phpunit>
